<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
<Properties>
		<Property name="basepath">./logs</Property>
		<Property name="timestamp">${date:yyyy-MM-dd_HH-mm-ss}</Property>
</Properties>

  <Appenders>
    <Console name="CONSOLE" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
    
    <RollingFile name="File" filename="${basepath}/automation.log" filePattern="${basepath}/automation-%d{yyyy-MM-dd}">
   		 <PatternLayout pattern="%d{HH:mm:ss.SSS}[%t] %-5level %logger{36} - %msg%n"/>
   			 <SizeBasedTriggeringPolicy size="5000" />
    </RollingFile>
    <!-- File Appender creating a new log file per execution -->
        <File name="ExecutionLogFile" fileName="${basepath}/TestExecution_${timestamp}.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </File>
      </Appenders>

  <Loggers>
    <Root level="INFO">
      <AppenderRef ref="File" />
      <AppenderRef ref="ExecutionLogFile"/>
    </Root>
     </Loggers>
</Configuration>